<?php
/**
 * setup_seed.php -- RUN ONCE, THEN DELETE THIS FILE.
 *
 * Loads the role-based test data set: four roles, two health centres with their
 * own health workers AND doctors, synthetic patients and a spread of
 * appointments in every status so that the reports and the audit log have
 * something to show.
 *
 * All records are SYNTHETIC. No real patient data is used anywhere.
 *
 * Browser:  http://localhost/telemed/setup_seed.php
 * Terminal: php setup_seed.php
 */
require_once __DIR__ . '/includes/init.php';

$isCli = PHP_SAPI === 'cli';
if (!$isCli && !in_array($_SERVER['REMOTE_ADDR'] ?? '', ['127.0.0.1', '::1'], true)) {
    http_response_code(403);
    exit('This script only runs on the local computer.');
}
if ((int)$pdo->query('SELECT COUNT(*) FROM users')->fetchColumn() > 0) {
    exit('The database already has users. Nothing was changed. Delete setup_seed.php.');
}

const SEED_PASSWORD = 'Test@1234';

$pw = hash_password(SEED_PASSWORD);

// Facility ids come from database.sql: 1 = Centre A, 2 = Centre B.
$facilities = [];
foreach ($pdo->query('SELECT facility_id, name FROM facilities ORDER BY facility_id') as $f) {
    $facilities[(int)$f['facility_id']] = $f['name'];
}
if (count($facilities) < 2) {
    exit('Import database.sql first: it creates the starter health centres.');
}
[$centreA, $centreB] = array_keys($facilities);

$pdo->beginTransaction();

// ---- users -----------------------------------------------------------
// Each health centre has a health worker AND a doctor (the doctor works
// inside the centre).
$insUser = $pdo->prepare(
    'INSERT INTO users (facility_id, full_name, phone, email, password_hash, role)
     VALUES (?, ?, ?, ?, ?, ?)'
);
$u = [];
foreach ([
    // key,    facility,  name,                   phone,        email,                 role
    ['admin',  null,      'System Administrator', '0970000001', 'admin@example.test',  'admin'],
    ['hwA',    $centreA,  'Mercy Chanda',         '0970000002', null,                  'health_worker'],
    ['hwB',    $centreB,  'Joseph Mulenga',       '0970000003', null,                  'health_worker'],
    ['docA',   $centreA,  'Dr Grace Banda',       '0970000004', 'g.banda@example.test','doctor'],
    ['docB',   $centreB,  'Dr Peter Mwale',       '0970000005', null,                  'doctor'],
    ['pat1',   null,      'Agness Mwanza',        '0970000006', null,                  'patient'],
    ['pat2',   null,      'Brian Kapata',         '0970000007', null,                  'patient'],
] as [$key, $fac, $name, $phone, $email, $role]) {
    $insUser->execute([$fac, $name, $phone, $email, $pw, $role]);
    $u[$key] = (int)$pdo->lastInsertId();
}

// ---- patients --------------------------------------------------------
$insPatient = $pdo->prepare(
    'INSERT INTO patients (user_id, patient_number, full_name, dob, sex, phone, village, facility_id)
     VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
);
$p = [];
foreach ([
    // key,    login,       number,         name,                 dob,          sex, phone,        village,       facility
    ['agness', $u['pat1'], 'LUF-26-00001', 'Agness Mwanza',      '1991-04-12', 'F', '0970000006', 'Kalulushi',   $centreA],
    // Brian registered himself and is not yet on any facility register:
    // use him to demonstrate Health worker > Patients > Attach.
    ['brian',  $u['pat2'], 'LUF-26-00002', 'Brian Kapata',       '1984-09-02', 'M', '0970000007', 'Mibenge',     null],
    ['alpha',  null,       'LUF-26-00003', 'Test Patient Alpha', '2019-01-20', 'M', null,          'Shimukunami', $centreA],
    ['beta',   null,       'LUF-26-00004', 'Test Patient Beta',  '1976-06-30', 'F', null,          'Kaniki',      $centreA],
    ['gamma',  null,       'LUF-26-00005', 'Test Patient Gamma', '2002-11-05', 'F', null,          'Lufwanyama',  $centreA],
    ['delta',  null,       'LUF-26-00006', 'Test Patient Delta', '1958-02-14', 'M', null,          'Mukutuma',    $centreB],
] as [$key, $uid, $no, $name, $dob, $sex, $phone, $village, $fac]) {
    $insPatient->execute([$uid, $no, $name, $dob, $sex, $phone, $village, $fac]);
    $p[$key] = (int)$pdo->lastInsertId();
}

// ---- appointments and consultations (with the doctor's reply) --------
$insAppt = $pdo->prepare(
    "INSERT INTO appointments
       (patient_id, booked_by, facility_id, doctor_id, department, appointment_date, reason, status, created_at)
     VALUES (?, ?, ?, ?, ?, DATE_ADD(CURDATE(), INTERVAL ? DAY), ?, ?, DATE_SUB(NOW(), INTERVAL ? HOUR))"
);
$insCons = $pdo->prepare(
    'INSERT INTO consultations (appointment_id, sent_by, answered_by, clinical_notes, doctor_response, responded_at)
     VALUES (?, ?, ?, ?, ?, ?)'
);

$rows = [
    // patient, booked_by, centre, doctor, day offset, reason, status, reply, answered_by, hours ago, notes
    [$p['agness'], $u['hwA'], $centreA, $u['docA'], 3,
     'Persistent fever for five days', 'pending', null, null, 20,
     "Temperature 38.9 C. Malaria RDT negative. No improvement on paracetamol.\nBP 118/76, pulse 96."],

    [$p['alpha'], $u['hwA'], $centreA, null, 6,
     'Child not gaining weight', 'confirmed', 'Bring the under-five card and come fasting.', $u['docA'], 44,
     "Weight 9.1 kg at 3 years. Appetite poor for 6 weeks. No oedema."],

    [$p['delta'], $u['hwB'], $centreB, $u['docB'], 9,
     'Hernia, increasing pain', 'rescheduled', 'Clinic is full that week; come on the new date.', $u['docB'], 30,
     "Right inguinal hernia, reducible, tender since Monday."],

    [$p['beta'], $u['hwA'], $centreA, $u['docA'], 14,
     'Loss of vision in the left eye', 'declined', 'Eye clinic runs on Tuesdays only. Rebook for a Tuesday.', $u['docA'], 8,
     "Gradual blurring over 4 months. Suspect cataract."],

    [$p['gamma'], $u['hwA'], $centreA, $u['docA'], -12,
     'First antenatal visit, high blood pressure', 'completed', 'Seen and started on treatment. Review in four weeks.', $u['docA'], 290,
     "BP 152/98 on two readings. 26 weeks by dates."],

    // Self-booked by the patient, no specific doctor, still waiting.
    [$p['agness'], $u['pat1'], $centreA, null, 10,
     'Toothache for three days', 'pending', null, null, 3, null],
];

foreach ($rows as [$pid, $by, $centre, $doctor, $offset, $why, $status, $reply, $answeredBy, $hoursAgo, $notes]) {
    $insAppt->execute([$pid, $by, $centre, $doctor, departmentFor($why), $offset, $why, $status, $hoursAgo]);
    $aid = (int)$pdo->lastInsertId();
    $insCons->execute([
        $aid, $by, $answeredBy, $notes,
        $reply,
        $answeredBy !== null ? date('Y-m-d H:i:s') : null,
    ]);
}

// ---- a couple of audit rows so the log is not empty ------------------
$pdo->prepare(
    "INSERT INTO audit_logs (user_id, action, entity, entity_id, details, ip_address)
     VALUES (?, 'SEED', 'database', NULL, 'Synthetic test data loaded', '127.0.0.1')"
)->execute([$u['admin']]);

$pdo->commit();

/** Pick a plausible department for each seeded reason. */
function departmentFor(string $reason): string
{
    $reason = strtolower($reason);
    return match (true) {
        str_contains($reason, 'child')     => 'Paediatrics',
        str_contains($reason, 'hernia')    => 'Surgery',
        str_contains($reason, 'vision')    => 'Eye Clinic',
        str_contains($reason, 'antenatal') => 'Maternity',
        str_contains($reason, 'tooth')     => 'Dental',
        default                            => 'General Medicine',
    };
}

// ---- report ----------------------------------------------------------
$accounts = [
    ['Administrator',             '0970000001'],
    ['Health worker, Centre A',   '0970000002'],
    ['Health worker, Centre B',   '0970000003'],
    ['Doctor, Centre A',          '0970000004'],
    ['Doctor, Centre B',          '0970000005'],
    ['Patient (Agness Mwanza)',   '0970000006'],
    ['Patient (Brian Kapata)',    '0970000007'],
];

if ($isCli) {
    echo 'Seed complete. Password for every account: ' . SEED_PASSWORD . "\n";
    foreach ($accounts as [$who, $phone]) {
        printf("  %-28s %s\n", $who, $phone);
    }
    echo "Now delete setup_seed.php.\n";
    exit;
}

$page_title = 'Test data loaded';
require __DIR__ . '/includes/header.php';
?>
<div class="card">
  <h1>&#9989; Test data loaded</h1>
  <p>Password for every account below: <strong><?= e(SEED_PASSWORD) ?></strong></p>
  <table>
    <tr><th>Role</th><th>Log in with</th></tr>
<?php foreach ($accounts as [$who, $phone]): ?>
    <tr><td><?= e($who) ?></td><td><?= e($phone) ?></td></tr>
<?php endforeach; ?>
  </table>
  <div class="msg err">Now delete <code>setup_seed.php</code> from the project folder.</div>
  <p><a class="btn" href="<?= e(url('/login.php')) ?>"><?= e(t('login')) ?></a></p>
</div>
<?php require __DIR__ . '/includes/footer.php'; ?>
